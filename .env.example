PORT=3000

# Official xAI / Grok API
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.3

# APIKEY.FUN or any OpenAI-compatible GPT gateway
GPT_API_KEY=
GPT_BASE_URL=https://api.apikey.fun/v1
GPT_MODEL=gpt-5.5

# Batch defaults
MAX_BATCH_SIZE=20
ANALYSIS_CONCURRENCY=3

# Local UI/demo mode. Set true to test without external API calls.
MOCK_LLM=false
